      "Book a tutoring session",
      "What are your fees?"
    ],
    "agentAvatar": "olivia",
    "agentName": "Olivia",
    "agentTitle": "Tutoring Coordinator",
    "preChatForm": {
      "enabled": true,
      "fields": [
        {
          "id": "name",
          "label": "Your name",
          "type": "text",
          "required": true,
          "placeholder": "John Doe"
        },
        {
          "id": "phone",
          "label": "Phone (optional)",
          "type": "tel",
          "required": false,
          "placeholder": "+971 50 123 4567"
        }
      ]
    },
    "proactiveGreeting": {
