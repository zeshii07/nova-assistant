# ─── v73.0: Production persistence (Redis + PostgreSQL) ───────────────────
# Switches Nova from in-memory/file snapshots to durable, multi-instance-safe
# storage. See PRODUCTION_PERSISTENCE.md for the full runbook + what each
# setting does + what's covered vs deferred.
#
# REQUIRED for persistent mode — the server refuses to start without these:
NOVA_STORAGE_MODE=persistent
DATABASE_URL=postgresql://nova:CHANGE_ME@localhost:5432/nova
REDIS_URL=redis://CHANGE_ME@localhost:6379
# ─── Conversation state TTL (Redis) ───────────────────────────────────────
NOVA_STATE_TTL_SECONDS=604800
# ─── PostgreSQL connection pool ───────────────────────────────────────────
NOVA_DB_POOL_MAX=10

# ─── REQUIRED secrets (set these even in memory mode for production) ──────
# JWT signing for business-owner auth. MUST be a stable, secret value in prod
# (the default is a random per-process key — every restart logs all owners out
# + invalidates pending password resets). Generate with: openssl rand -hex 32
NOVA_JWT_SECRET=CHANGE_ME_to_a_long_random_hex_string
# HMAC for OAuth state tokens (Google/Microsoft calendar consent). Prevents
# the callback CSRF where an attacker's auth code is saved to a victim tenant.
# Generate with: openssl rand -hex 32
NOVA_OAUTH_STATE_SECRET=CHANGE_ME_to_a_different_long_random_hex_string

# ─── Optional tuning ──────────────────────────────────────────────────────
# PG ssl/timeout passthrough (set PGSSLMODE=require on managed Postgres).
# PGSSLMODE=require
# PGCONNECT_TIMEOUT=10
