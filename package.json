{
  "name": "nova-saas-universal-engagement",
  "version": "17.0.0",
  "private": true,
  "description": "Nova v17.0 — Embedding-Based Product Matcher + Silent Service Swap Fix + ML Intent Classifier + Conversation Memory + Unified Entity Extraction + State Machine",
  "main": "apps/api/src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node apps/api/src/server.js",
    "dev": "node --watch apps/api/src/server.js",
    "test": "node --require ./tests/test-env.js --test",
    "check": "node scripts/check.js",
    "demo:users": "node scripts/demo-multi-user.js",
    "demo:cleaning": "node scripts/demo-cleaning-business.js",
    "test:conversations": "node --require ./tests/test-env.js scripts/run-conversation-datasets.js",
    "db:migrate": "node scripts/migrate.js",
    "benchmark:v7": "node scripts/benchmark-v7.js",
    "benchmark:persistent": "node scripts/benchmark-persistence-live.js",
    "benchmark:v72": "node scripts/benchmark-v72.js",
    "benchmark:v73": "node --test tests/sprint43.workflow-meaning-before-slot.integration.test.js",
    "benchmark:v8": "node scripts/benchmark-v8.js",
    "benchmark:v8.1": "node --test tests/sprint45.v81-product-goal-and-native-pdf.integration.test.js && npm test && npm run test:conversations && npm run check && node scripts/audit-state-safety.js",
  
    "benchmark:v15.0": "node --require ./tests/test-env.js --test tests/sprint85.v150-conversation-memory-entity-state.integration.test.js",
    "benchmark:v16.0": "node --require ./tests/test-env.js --test tests/sprint86.v160-ml-intent-classifier.integration.test.js tests/sprint87.v160-hybrid-routing.integration.test.js",
    "benchmark:v17.0": "node --require ./tests/test-env.js --test tests/sprint88.v170-product-embedding-matcher.integration.test.js tests/sprint89.v170-silent-service-swap-fix.integration.test.js",
    "model:groq:check": "node scripts/check-groq-nlu.js",
    "model:groq:trace": "node scripts/trace-groq-routing.js",
    "model:language:trace": "node scripts/trace-groq-routing.js",
    "model:semantic:trace": "node scripts/trace-semantic-router.js"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "redis": "^5.8.1",
    "pdf-parse": "^2.4.5"
  }
}