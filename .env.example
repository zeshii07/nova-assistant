NODE_ENV=development
PORT=3000
DEFAULT_TENANT_ID=default
LOG_LEVEL=info
TENANTS_DIR=./tenants

# Optional Groq provider. Required only when NOVA_NLU_MODE=on.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Default tenant WhatsApp Cloud API credentials
# Keep secrets in environment variables, not tenant JSON files.
WHATSAPP_PHONE_NUMBER_ID_DEFAULT=
WHATSAPP_ACCESS_TOKEN_DEFAULT=
WHATSAPP_VERIFY_TOKEN_DEFAULT=change-this-random-token
WHATSAPP_APP_SECRET_DEFAULT=

# Protect /api/dev/* when deploying the Developer Console publicly.
# Production mode denies these endpoints when this value is missing. Use a
# long random secret and send it as the x-nova-dev-token request header.
NOVA_DEV_TOKEN=
# Default actor context for v9 Control Plane requests. The browser console can
# override these after successful developer-token authentication.
NOVA_DEV_ACTOR_ID=local-developer
NOVA_DEV_ROLE=owner

# Nova v7 storage. Memory mode is the safe local/test default.
NOVA_STORAGE_MODE=memory
# All local durable data, including uploaded knowledge and published pricing.
# On an ephemeral host, mount this path to a persistent disk/volume.
NOVA_LOCAL_DATA_DIR=./.nova-data
# Optional separate mounted locations. Leave blank to use NOVA_LOCAL_DATA_DIR.
NOVA_KNOWLEDGE_DATA_DIR=
NOVA_OPERATIONAL_DATA_DIR=
DATABASE_URL=
REDIS_URL=
NOVA_STATE_TTL_SECONDS=604800
NOVA_DB_POOL_MAX=10
# How long a variant/SKU remains held while a customer completes checkout.
NOVA_INVENTORY_RESERVATION_TTL_SECONDS=900

# Nova's local statistical semantic router is enabled by default and does not
# need an API key. It recognizes multilingual intent/paraphrase variation and
# arbitrates only among Nova's deterministic capabilities.
NOVA_SEMANTIC_ROUTER_MODE=on
NOVA_SEMANTIC_ROUTER_MIN_CONFIDENCE=0.72
NOVA_SEMANTIC_ROUTER_MIN_MARGIN=0.08
NOVA_SEMANTIC_ROUTER_MIN_SIMILARITY=0.20
NOVA_SEMANTIC_ROUTER_MAX_LOCAL_INTENTS=2

# Optional remote NLU. "off" means Local Semantic Router + deterministic Nova.
# "on" sends only unresolved, conflicting, ambiguous, or complex language to
# Groq for schema-constrained interpretation. Groq never executes business
# actions. If it is unavailable, Nova uses a safe deterministic route or asks
# a tenant-aware clarification question.
NOVA_NLU_MODE=off
# adaptive: local rules first, AI only for uncertain messages (fast/low cost)
# primary: every message is interpreted first, with automatic local fallback
NOVA_NLU_STRATEGY=adaptive
# This is Groq's OpenAI-compatible endpoint. The request is sent to Groq.
NOVA_GROQ_NLU_BASE_URL=https://api.groq.com/openai/v1
# `openai/` identifies the model publisher/family. Groq hosts and serves it.
NOVA_GROQ_NLU_MODEL=openai/gpt-oss-20b
NOVA_DEFAULT_TIMEZONE=Asia/Karachi
NOVA_GROQ_NLU_TIMEOUT_MS=4000
# After one failed/timeout request, skip remote calls briefly so a provider
# issue cannot delay every customer message. Set 0 to disable this circuit.
NOVA_GROQ_NLU_FAILURE_COOLDOWN_MS=15000
NOVA_NLU_MIN_CONFIDENCE=0.78
NOVA_NLU_INFORMATION_THRESHOLD=0.86
NOVA_NLU_ACTION_THRESHOLD=0.92
NOVA_NLU_INVOCATION_THRESHOLD=0.86
NOVA_NLU_AMBIGUITY_MARGIN=0.05
NOVA_NLU_MAX_INPUT_CHARS=4000
