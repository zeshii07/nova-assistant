# ═══════════════════════════════════════════════════════════════
# Nova Assistant — Environment Configuration (v22.0)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed.
#
# STORAGE MODE:
#   memory      = In-memory + JSON file snapshots (default, dev only)
#   persistent  = PostgreSQL + Redis (production, survives restarts)
# ═══════════════════════════════════════════════════════════════

# ── Core Settings ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Default tenant when none is specified in the request
DEFAULT_TENANT_ID=cleaning-demo

# Default timezone for date/time parsing
NOVA_DEFAULT_TIMEZONE=Asia/Karachi

# ── Storage Mode ───────────────────────────────────────────────
# memory     = dev mode (JSON files in .nova-data/)
# persistent = production mode (PostgreSQL + Redis)
NOVA_STORAGE_MODE=memory

# ── PostgreSQL (required when NOVA_STORAGE_MODE=persistent) ────
# Local Docker: postgresql://nova:nova@localhost:5432/nova
# Render:       postgresql://user:pass@host:port/dbname
# Neon:         postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Max database connections in the pool
NOVA_DB_POOL_MAX=10

# ── Redis (required when NOVA_STORAGE_MODE=persistent) ────────
# Local Docker: redis://localhost:6379
# Render:       rediss://red-xxx:6379
# Upstash:      rediss://default:password@xxx.upstash.io:6379
REDIS_URL=

# How long conversation state persists in Redis (seconds)
# Default: 604800 = 7 days. Min: 60, Max: 31536000 (1 year)
NOVA_STATE_TTL_SECONDS=604800

# ── Data Directories (memory mode) ────────────────────────────
# Where JSON snapshots are stored (memory mode only)
NOVA_LOCAL_DATA_DIR=.nova-data

# Where tenant operational data is stored (inventory, calendar)
NOVA_OPERATIONAL_DATA_DIR=.nova-data/tenant-operational

# Where tenant knowledge documents are stored
NOVA_KNOWLEDGE_DATA_DIR=.nova-data/tenant-knowledge

# ── Inventory ──────────────────────────────────────────────────
# How long inventory reservations are held (seconds)
# Default: 900 = 15 minutes
NOVA_INVENTORY_RESERVATION_TTL_SECONDS=900

# ── Tenants ───────────────────────────────────────────────────
# Directory containing tenant configuration (profile.json, etc.)
TENANTS_DIR=./tenants

# ── NLU / AI (optional) ────────────────────────────────────────
# Groq API key for remote NLU (optional — leave empty for deterministic-only)
GROQ_API_KEY=
GROQ_NLU_MODEL=llama-3.1-8b-instant
GROQ_NLU_BASE_URL=https://api.groq.com/openai/v1
GROQ_NLU_TIMEOUT_MS=10000

# NLU strategy: off | adaptive | primary
NOVA_NLU_STRATEGY=off

# Semantic router (local TF-IDF, no API key needed)
NOVA_SEMANTIC_ROUTER_MODE=on
NOVA_SEMANTIC_ROUTER_MIN_CONFIDENCE=0.76
NOVA_SEMANTIC_ROUTER_MIN_MARGIN=0.08
NOVA_SEMANTIC_ROUTER_MIN_SIMILARITY=0.20
NOVA_SEMANTIC_ROUTER_MAX_LOCAL_INTENTS=2

# ── Channel: WhatsApp (optional) ───────────────────────────────
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
