# ═══════════════════════════════════════════════════════════════
# Nova Assistant — Environment Configuration (v22.0)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values as needed.
#
# STORAGE MODE:
#   memory      = In-memory + JSON file snapshots (default, dev only)
#   persistent  = PostgreSQL + Redis (production, survives restarts)
# ═══════════════════════════════════════════════════════════════

# ── Core Settings ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Default tenant when none is specified in the request
DEFAULT_TENANT_ID=cleaning-demo

# Default timezone for date/time parsing
NOVA_DEFAULT_TIMEZONE=Asia/Karachi

# ── Storage Mode ───────────────────────────────────────────────
# memory     = dev mode (JSON files in .nova-data/)
# persistent = production mode (PostgreSQL + Redis)
NOVA_STORAGE_MODE=memory

# ── Cluster Workers ─────────────────────────────────────────────
# npm start forks up to 4 workers (one per CPU core, capped).
# IMPORTANT (C2 fix): each worker keeps its own in-memory conversation state.
# With NOVA_STORAGE_MODE=memory and more than one worker, conversation state
# is NOT shared and state.json is overwritten on disk (last writer wins), so
# a user's next message can land on a worker that has never seen them. In
# production (NODE_ENV=production) the server REFUSES to boot in this
# configuration — pick ONE of:
#   • Set NOVA_WORKERS=1 (single worker, memory storage is then safe), OR
#   • Set NOVA_STORAGE_MODE=persistent with DATABASE_URL + REDIS_URL (state
#     lives in Redis, shared across workers).
# NOVA_SINGLE_WORKER=true overrides everything to single-process mode (debug).
NOVA_WORKERS=1
# NOVA_SINGLE_WORKER=true

# Worker heartbeat watchdog (also contains a C1-style freeze: a worker stuck
# in a lock-spin stops heartbeating and is killed + restarted). Defaults are
# tuned to detect a frozen worker within ~15s.
# NOVA_WORKER_HEARTBEAT_MS=5000
# NOVA_WORKER_MAX_MISSED_BEATS=3

# ── PostgreSQL (required when NOVA_STORAGE_MODE=persistent) ────
# Local Docker: postgresql://nova:nova@localhost:5432/nova
# Render:       postgresql://user:pass@host:port/dbname
# Neon:         postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Max database connections in the pool
NOVA_DB_POOL_MAX=10

# ── Redis (required when NOVA_STORAGE_MODE=persistent) ────────
# Local Docker: redis://localhost:6379
# Render:       rediss://red-xxx:6379
# Upstash:      rediss://default:password@xxx.upstash.io:6379
REDIS_URL=

# How long conversation state persists in Redis (seconds)
# Default: 604800 = 7 days. Min: 60, Max: 31536000 (1 year)
NOVA_STATE_TTL_SECONDS=604800

# ── Data Directories (memory mode) ────────────────────────────
# Where JSON snapshots are stored (memory mode only)
NOVA_LOCAL_DATA_DIR=.nova-data

# Where tenant operational data is stored (inventory, calendar)
NOVA_OPERATIONAL_DATA_DIR=.nova-data/tenant-operational

# Where tenant knowledge documents are stored
NOVA_KNOWLEDGE_DATA_DIR=.nova-data/tenant-knowledge

# ── Inventory ──────────────────────────────────────────────────
# How long inventory reservations are held (seconds)
# Default: 900 = 15 minutes
NOVA_INVENTORY_RESERVATION_TTL_SECONDS=900

# ── Tenants ───────────────────────────────────────────────────
# Directory containing tenant configuration (profile.json, etc.)
TENANTS_DIR=./tenants

# ── NLU / AI (optional) ────────────────────────────────────────
# Groq API key for remote NLU. Also accepted as the legacy alias
# NOVA_GROQ_NLU_API_KEY (GROQ_API_KEY wins if both are set). Leave empty for
# deterministic-only NLU (NOVA_NLU_MODE defaults to off when no key is set).
GROQ_API_KEY=

# ── NLU mode + strategy ────────────────────────────────────────
# NOVA_NLU_MODE: off (deterministic, default when no Groq key) | on (LLM-assisted).
# NOVA_NLU_STRATEGY: adaptive (default; use Groq when confident, else deterministic)
#   | primary (always route through Groq when NOVA_NLU_MODE=on).
#   NOTE: "off" is NOT a valid NLU strategy value — it will crash the server
#   on boot ("NOVA_NLU_STRATEGY must be adaptive or primary"). Use
#   NOVA_NLU_MODE=off to disable LLM NLU instead.
NOVA_NLU_MODE=off
NOVA_NLU_STRATEGY=adaptive

# ── Groq NLU client (only used when NOVA_NLU_MODE=on) ──────────
# These MUST use the NOVA_ prefix — the bare GROQ_NLU_MODEL /
# GROQ_NLU_BASE_URL / GROQ_NLU_TIMEOUT_MS names are NOT read by config.js
# (they were a docs bug; set the value, get silence). The legacy aliases are
# accepted for backward compat but emit a deprecation warning.
NOVA_GROQ_NLU_BASE_URL=https://api.groq.com/openai/v1
NOVA_GROQ_NLU_MODEL=openai/gpt-oss-20b
NOVA_GROQ_NLU_TIMEOUT_MS=4000
NOVA_GROQ_NLU_FAILURE_COOLDOWN_MS=15000

# NLU confidence thresholds (defaults shown; tune per deployment).
NOVA_NLU_MIN_CONFIDENCE=0.78
NOVA_NLU_INFORMATION_THRESHOLD=0.86
NOVA_NLU_ACTION_THRESHOLD=0.92
NOVA_NLU_INVOCATION_THRESHOLD=0.86
NOVA_NLU_AMBIGUITY_MARGIN=0.05
NOVA_NLU_MAX_INPUT_CHARS=4000

# ── Public-assistant LLM generation (v16/§17) ─────────────────
# off (default — deterministic public assistant) | on (use LLM when an
# llmRouter provider is configured). Explicit =off always wins.
NOVA_PUBLIC_LLM_MODE=off

# Semantic router (local TF-IDF, no API key needed)
NOVA_SEMANTIC_ROUTER_MODE=on
NOVA_SEMANTIC_ROUTER_MIN_CONFIDENCE=0.72
NOVA_SEMANTIC_ROUTER_MIN_MARGIN=0.08
NOVA_SEMANTIC_ROUTER_MIN_SIMILARITY=0.20
NOVA_SEMANTIC_ROUTER_MAX_LOCAL_INTENTS=2

# ── Channel: WhatsApp (optional) ───────────────────────────────
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ── Email Notifications (v30.0) ────────────────────────────────
# Gmail SMTP setup:
#   1. Enable 2FA on your Gmail account
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-char password (no spaces) as NOVA_SMTP_PASS
#   4. Set NOVA_SMTP_FROM to "Your Business <your-email@gmail.com>"
#
# If these are NOT set, Nova logs emails instead of sending them (dev mode).

NOVA_SMTP_HOST=smtp.gmail.com
NOVA_SMTP_PORT=587
NOVA_SMTP_USER=
NOVA_SMTP_PASS=
NOVA_SMTP_FROM=Nova Assistant <noreply@example.com>

# ── Google Calendar Integration (v31.0) ──────────────────────────
# Setup:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or select existing)
#   3. Enable Google Calendar API:
#      https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
#   4. Create OAuth 2.0 credentials:
#      https://console.cloud.google.com/apis/credentials
#      - Application type: Web application
#      - Authorized redirect URI: https://your-nova.com/api/admin/calendar/callback
#   5. Copy the Client ID and Client Secret here
#   6. Configure the OAuth consent screen:
#      https://console.cloud.google.com/apis/credentials/consent
#      - Add your domain to "Authorized domains"
#      - Add scope: calendar.events
#
# If these are NOT set, Google Calendar integration is disabled and
# Nova falls back to the local calendar (no real availability check).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/calendar/callback